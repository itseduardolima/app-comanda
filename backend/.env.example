# PostgreSQL connection string (see docker-compose.yml for local dev)
DATABASE_URL=postgresql://app_comanda:app_comanda@localhost:5432/app_comanda?schema=public

# Secret used to sign JWT access tokens (use a long random string in production)
JWT_SECRET=change-me

# JWT expiration (default: 12h — one restaurant shift)
JWT_EXPIRES_IN=12h

# HTTP port (default: 3000)
PORT=3000
